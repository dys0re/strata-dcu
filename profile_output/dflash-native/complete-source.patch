index 0000000..7d03a85
--- /dev/null
+++ b/tools/report_dflash2_native.py
@@ -0,0 +1,54 @@
+"""Summarize functional DFlash2 QA first, followed by the measured speed smoke."""
+import argparse
+import json
+from pathlib import Path
+
+
+def summarize(root):
+    def read(run):
+        assert (root / (run + ".log")).read_text().rstrip().endswith("PASS"), run
+        return json.loads((root / run / "results.json").read_text())
+    reference = {r["case"]: r for r in read("qa-reference")}
+    qa = {}
+    for run in ["qa-full", "qa-adaptive"]:
+        records = read(run)
+        matches = {r["case"]: r["generated_ids"] == reference[r["case"]]["generated_ids"] for r in records}
+        assert all(matches.values()), matches
+        protocol = json.loads((root / run / "protocol.json").read_text())
+        assert protocol["cancel"].split()[5] == "cancel"
+        assert protocol["recovery"].split()[5] == "stop"
+        qa[run] = dict(requests=len(records), output_tokens=sum(len(r["generated_ids"]) for r in records),
+                       exact_target_matches=matches, protocol=protocol)
+    long = read("qa-long")
+    assert [r["text"].strip() for r in long] == ["ORBIT", "OK"]
+    assert len(long[0]["prompt_ids"]) == 2100
+    perf = read("bench-native")
+    usages = {run: json.loads((root / run / "weight-usage.json").read_text())
+              for run in ["qa-full", "qa-reference", "qa-adaptive", "qa-long", "bench-native"]}
+    for run, u in usages.items():
+        assert u["weights"] <= u["limit"] == u["total"] // 2
+        assert u["weights"] == sum(u[k] for k in ["pack", "dense", "head", "experts", "mtp", "external_draft", "native_draft"])
+    witness = json.loads((root / "witness" / "report.json").read_text())
+    assert witness["eager_graph_equal"] and witness["repeat_reset_incremental_equal"]
+    golden = root.parent / "dflash2" / "quality-final" / "results.json"
+    comparison = {}
+    if golden.exists():
+        old = {r["case"]: r for r in json.loads(golden.read_text())}
+        comparison = {r["case"]: r["generated_ids"] == old[r["case"]]["generated_ids"]
+                      for r in perf if r["case"] in old}
+        assert all(comparison.values()), comparison
+    summary = dict(qa=qa, long_context=dict(prompt_tokens=2100,answers=[r["text"].strip() for r in long],
+                  request_recovery=True), weights=usages,
+                  speed_smoke={r["case"]:r["decode_tps"] for r in perf if r["case"]!="warmup"},
+                  speed_repeats_per_workload=1, speed_output_equivalence=comparison,
+                  eager_graph_equal=True, cache_reset_incremental_equal=True,
+                  pytorch_hidden_relative_l2_max=max(r["relative_l2"] for r in witness["modes"]["graph"]),
+                  pytorch_draft_parity_claimed=False)
+    (root / "summary.json").write_text(json.dumps(summary,ensure_ascii=False,indent=2)+"\n")
+    print(json.dumps(summary,ensure_ascii=False,indent=2))
+
+
+if __name__ == "__main__":
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("root",type=Path)
+    summarize(ap.parse_args().root)
diff --git a/tools/audit_dflash2_native.py b/tools/audit_dflash2_native.py
new file mode 100644
index 0000000..5942781
--- /dev/null
+++ b/tools/audit_dflash2_native.py
@@ -0,0 +1,46 @@
+"""Freeze native DFlash deployment provenance; omit large local-only fixtures from Git."""
+import hashlib
+import json
+import os
+import subprocess
+from pathlib import Path
+
+root=Path('/root/private_data/strata-dcu/dflash-native')
+source=Path('/root/strata-dcu/Strata')
+def sha(path):
+    with path.open('rb') as f:
+        return hashlib.file_digest(f,'sha256').hexdigest()
+
+names=['CMakeLists.txt','include/strata/core/dflash_bridge.hpp','include/strata/core/dflash_native.hpp',
+       'include/strata/core/verify.hpp','include/strata/prefill/prefill.hpp','src/program/generate.cpp',
+       'src/prefill/dflash.cu','src/prefill/dflash_witness.cpp','tools/dflash2_pack.py',
+       'tools/autoround_pack.py','tools/bench_dflash2_native.py','tools/test_dflash2_native.py',
+       'tools/report_dflash2_native.py','tools/audit_dflash2_native.py']
+jobs=[]
+for proc in Path('/proc').iterdir():
+    if not proc.name.isdigit():
+        continue
+    try:
+        args=(proc/'cmdline').read_bytes().decode(errors='replace').split('\0')
+    except (OSError,ProcessLookupError):
+        continue
+    if not args:
+        continue
+    executable=Path(args[0]).name
+    is_engine=executable in ['strata','strata-final','dflash_native_witness']
+    is_driver=executable.startswith('python') and any(Path(a).name in
+        ['bench_dflash2_native.py','strata_dflash2.py','dflash2_worker.py'] for a in args[1:3])
+    if is_engine or is_driver:
+        jobs.append(dict(pid=int(proc.name),args=args))
+assert not jobs,jobs
+fixtures=sorted((root/'witness').glob('features-*.f32'))
+audit=dict(binary_sha256=sha(root/'strata-final'),
+           default_engine=os.path.realpath('/root/strata-dcu/build-gfx936/strata'),
+           source_sha256={n:sha(source/n) for n in names},
+           pack_weight_sha256=sha(root/'pack/weights.bin'),pack_bytes=(root/'pack/weights.bin').stat().st_size,
+           active_jobs=jobs,memory_events=Path('/sys/fs/cgroup/memory.events').read_text(),
+           root_layer=subprocess.check_output(['du','-xsh','/root'],text=True).strip(),
+           remote_only_fixtures=[dict(path=str(p),bytes=p.stat().st_size,sha256=sha(p)) for p in fixtures],
+           old_binary_retained=Path('/root/private_data/strata-dcu/dflash2/strata-final').is_file())
+(root/'audit.json').write_text(json.dumps(audit,indent=2)+'\n')
+print(json.dumps({k:v for k,v in audit.items() if k not in ['source_sha256','remote_only_fixtures']},indent=2))
