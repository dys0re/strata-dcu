+        p.alloc(p.partscores,7*((V+255)/256)*TOP,err)&&p.alloc(p.partids,7*((V+255)/256)*TOP,err)&&
+        p.alloc(p.best,7*TOP,err)&&p.alloc(p.candidates,7*TOP,err)&&p.alloc(p.tokens,7,err)&&
