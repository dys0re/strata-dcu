+// Unquantized projections of an AutoRound checkpoint. Keep the BF16 weight bits;
+// activations use the same Q8_1 contract as the other native projection types.
+__global__ void bf16_q81_kernel(const uint16_t* w, const Q81Block* x, float* y,
+                                int n_in, int n_out) {
+    const int lane = threadIdx.x & 31;
+    const int row = int(blockIdx.x) * 4 + int(threadIdx.x) / 32;
+    if (row >= n_out) return;
+    const int col = blockIdx.y;
+    const Q81Block* a = x + size_t(col) * (n_in / 32);
+    float sum = 0.0f;
+    for (int i = lane; i < n_in; i += 32) {
+        const float weight = __uint_as_float(uint32_t(w[size_t(row) * n_in + i]) << 16);
+        const float value = __half2float(__low2half(a[i / 32].ds)) * float(a[i / 32].qs[i % 32]);
+        sum = __fmaf_rn(weight, value, sum);
+    }
+    for (int off = 16; off > 0; off >>= 1)
+        sum += __shfl_down_sync(0xffffffffu, sum, off, 32);
+    if (lane == 0) y[size_t(col) * n_out + row] = sum;
+}
 struct Q20Block {
